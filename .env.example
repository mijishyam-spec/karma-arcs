# PostgreSQL connection string
# Local example:
# DATABASE_URL="postgresql://karma_arcs:karma_arcs_dev@localhost:5432/karma_arcs?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/karma_arcs?schema=public"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=""

# App URL used by Auth.js (local dev)
AUTH_URL="http://localhost:3000"

# Set to true on Vercel so Auth.js trusts the deployment host
AUTH_TRUST_HOST="true"

# Public app name shown in the UI
NEXT_PUBLIC_APP_NAME="Karma Arcs"

# Optional file storage (added in Phase 0 Sprint 2)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
